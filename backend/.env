# Environment variables for AQI Prediction API

# WAQI API Key (get it from http://aqicn.org/data-platform/token/)
WAQI_API_KEY=your_waqi_api_key_here

# OpenAQ API Key (get it from https://explore.openaq.org/register)
OPENAQ_API_KEY=your_openaq_api_key_here

# Flask settings
FLASK_ENV=development
DEBUG=True

# Other configurations can be added here